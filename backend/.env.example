# Copy this file to .env and fill in the values marked below.
# Everything else has a working default and can be left as-is to start.

# ============================================================
# Database (local PostgreSQL with the pgvector extension installed
# on the server - see README "Setup - 1. PostgreSQL + pgvector")
# DB_NAME must be an existing (empty) database; the backend creates
# the extension and all tables in it on startup. The port is 5432;
# for another one, put it into DB_HOST (e.g. localhost:5433). If the
# password contains @ or %, URL-encode it (@ -> %40, % -> %25).
# ============================================================
DB_USER=postgres
DB_PASS=change_me
DB_NAME=rag_assistant
DB_HOST=localhost

# ============================================================
# Auth (local username/password login)
# ============================================================
JWT_SECRET_KEY=change_me_to_a_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================
# GitHub OAuth - OPTIONAL. Only needed for GitHub sign-in and
# for the "Own" / "Collaborator" repo tabs. You can fully exercise
# the app without this - see README "Quick start / smoke test".
# If you do want it: README "Optional: GitHub OAuth App".
# ============================================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/github/callback
FRONTEND_URL=http://localhost:5173

# Optional fallback token used for GitHub API calls when the signed-in
# user is a local (non-GitHub) account. Not required for adding/indexing
# PUBLIC repos, but raises the otherwise very low (60/hour) anonymous
# GitHub API rate limit, and is required to index PRIVATE repos
# while signed in with a local (non-GitHub) account.
GITHUB_API_TOKEN=

# ============================================================
# RAG: text splitting (langchain-text-splitters)
# Chunk size/overlap are in CHARACTERS, not tokens.
# ============================================================
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200

# ============================================================
# RAG: GitHub ingestion limits
# ============================================================
RAG_MAX_FILE_SIZE_BYTES=307200
RAG_MAX_FILES_PER_REPO=800
# A repository that has been "indexing" for longer than this many
# minutes is marked as failed, so it can be started again (a safety net
# for a hung job; jobs killed by a server restart are failed at startup).
INDEXING_TIMEOUT_MINUTES=60

# ============================================================
# Ollama - runs the embedding model and the LLM (README "Setup - 2.
# Ollama"). Pull both models first:
#   ollama pull qwen3-embedding:0.6b
#   ollama pull qwen3.5:4b
# ============================================================
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Upper limit for one Ollama call, in seconds (it can include loading
# a model into memory, hence generous).
OLLAMA_TIMEOUT_SECONDS=300
# How long Ollama keeps a model loaded after its last use.
OLLAMA_KEEP_ALIVE=30m

# ============================================================
# RAG: embeddings (via Ollama)
# qwen3-embedding:0.6b: multilingual (100+ languages) and trained for
# code retrieval, 32k-token context, 1024-dim vectors. See README
# "Configuration reference" for why this model.
# ============================================================
EMBEDDING_MODEL_NAME=qwen3-embedding:0.6b
# Must match the embedding model's vector size. If it changes, the
# backend drops all indexed chunks at the next start and every
# repository has to be indexed again.
EMBEDDING_DIMENSIONS=1024
# Chunks per embedding request while indexing.
EMBEDDING_BATCH_SIZE=32
# Put in front of each question / each indexed chunk before embedding.
# Model-specific: Qwen3-Embedding wants this English task instruction
# on queries (keep the double quotes - they make \n a line break) and
# nothing on documents. Change both together with the model.
EMBEDDING_QUERY_PREFIX="Instruct: Given a question about a software repository, retrieve the source code or documentation that answers it\nQuery:"
EMBEDDING_DOCUMENT_PREFIX=

# ============================================================
# RAG: retrieval
# ============================================================
# How many chunks are included in the final answer prompt.
RAG_TOP_K=6

# ============================================================
# RAG: reranking (OPTIONAL, disabled by default)
# A second-pass cross-encoder step that re-scores the retrieved
# chunks before the top RAG_TOP_K are kept. Implemented, but
# off by default: the tested cross-encoder models were not a good
# fit for Hungarian-language queries over source-code passages -
# see README "Known limitations" before enabling this.
# It's the only model that doesn't run in Ollama (no reranking API):
# enabling it needs `pip install -r requirements-rerank.txt` first.
# ============================================================
RERANK_ENABLED=false
# Only used when RERANK_ENABLED=true: how many candidates the initial
# vector search retrieves before reranking narrows them down to RAG_TOP_K.
RERANK_CANDIDATES=25
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
# ============================================================
# RAG: source-file-type bias
# Small score adjustment applied before the final top-K cut, so that
# source code is favored over documentation files when both are
# similarly relevant to the question.
# ============================================================
CODE_FILE_BOOST=0.05
DOC_FILE_PENALTY=0.08

# ============================================================
# RAG: LLM used to generate answers (via Ollama)
# qwen3.5:4b is Ollama's 4-bit (Q4_K_M) build, ~4 GB. Its "thinking"
# mode is switched off by the backend (think: false).
# ============================================================
LLM_MODEL_NAME=qwen3.5:4b
# Maximum answer length, in tokens.
LLM_MAX_NEW_TOKENS=512
# Context window (prompt + answer, in tokens) requested for each answer.
# Ollama's own default is only 4096 on GPUs under 24 GB of VRAM.
LLM_CONTEXT_LENGTH=8192

# ============================================================
# Repository access control
# How long (in hours) a recorded "user X can access repo Y" grant is
# trusted before it is re-verified live against the GitHub API on the
# next question asked about that repo.
# ============================================================
REPOSITORY_ACCESS_TTL_HOURS=24
